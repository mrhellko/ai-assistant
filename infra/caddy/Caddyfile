{$ASSISTANT_DOMAIN} {
  log {
    output stdout
    format json
  }

  encode zstd gzip

  @binance_trader_telegram_webhook path /integrations/binance-trader/telegram/webhook
  handle @binance_trader_telegram_webhook {
    request_body {
      max_size 64KB
    }
    reverse_proxy binance-trader-webhook-upstream:8080
  }

  handle /api/telegram/webhook {
    reverse_proxy assistant:8000
  }

  handle /health {
    reverse_proxy assistant:8000
  }

  handle {
    respond "ok" 200
  }
}
